      const onEdge=(c===0||c===cols||r===0||r===rows);
      if(!onEdge){ x+=(rand()-0.5)*cw*jitterAmt; y+=(rand()-0.5)*ch*jitterAmt; }
      pts[r][c]={x:Math.max(0,Math.min(W,x)), y:Math.max(0,Math.min(H,y))};
    }
  }
  const sampleAt=(x,y)=>{
    const xi=Math.max(0,Math.min(W-1,Math.round(x))), yi=Math.max(0,Math.min(H-1,Math.round(y)));
    const i=(yi*W+xi)*4; return [src[i],src[i+1],src[i+2]];
  };
  ctx.clearRect(0,0,W,H);
  ctx.lineJoin='round';
  const outW=Math.max(1,Math.round(Math.min(W,H)/1400));
  const drawTri=(a,b,c)=>{
    const cx=(a.x+b.x+c.x)/3, cy=(a.y+b.y+c.y)/3;
    const s0=sampleAt(cx,cy),s1=sampleAt(a.x,a.y),s2=sampleAt(b.x,b.y),s3=sampleAt(c.x,c.y);
    const r=Math.round((s0[0]*2+s1[0]+s2[0]+s3[0])/5);
    const g=Math.round((s0[1]*2+s1[1]+s2[1]+s3[1])/5);
    const bl=Math.round((s0[2]*2+s1[2]+s2[2]+s3[2])/5);
    ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.lineTo(c.x,c.y);ctx.closePath();
    ctx.fillStyle=`rgb(${r},${g},${bl})`;
    // gleichfarbig 1px umranden, damit keine AA-Fugen zwischen den Dreiecken bleiben
    ctx.strokeStyle=ctx.fillStyle;ctx.lineWidth=1;ctx.stroke();ctx.fill();
    if(outline){ctx.strokeStyle='rgba(0,0,0,0.2)';ctx.lineWidth=outW;ctx.stroke();}
  };
  for(let r=0;r<rows;r++)for(let c=0;c<cols;c++){
    const tl=pts[r][c],tr=pts[r][c+1],bl=pts[r+1][c],br=pts[r+1][c+1];
    if((r+c)%2===0){ drawTri(tl,tr,bl); drawTri(tr,br,bl); }
    else{ drawTri(tl,tr,br); drawTri(tl,br,bl); }
  }
}

// ── Slicer (manual handles) ────────────────────────────
const EFFECT_LIST = ['original','duotone','dither','glitch','ascii','risograph','posterize','solarize','pixelate','halftone','threshold','blueprint','gradmap','flash','neon','micro','lowpoly'];
const EFFECT_LABELS = {original:'Original',duotone:'Duotone',dither:'Dither',glitch:'Glitch',ascii:'ASCII',risograph:'Risograph',posterize:'Posterize',solarize:'Solarize',pixelate:'Pixelate',halftone:'Halftone',threshold:'Threshold',blueprint:'Blueprint',gradmap:'Gradient-Map',flash:'Blitzlicht',neon:'Neon-Noir',micro:'Industrial',lowpoly:'Low-Poly'};
let slicerLines = []; // [{pos:0.33}, {pos:0.66}] as fractions 0-1
let slicerZoneEffects = ['duotone','original','duotone']; // effects per zone
let slicerDragging = null;

function slicerZoneCount(){ return slicerLines.length + 1; }

function slicerBuildZoneControls() {
  const c = document.getElementById('sl-zone-controls'); c.innerHTML = '';
  const orient = document.getElementById('sl-orient').value;
  const n = slicerZoneCount();
  // Preserve existing values, pad if needed
  while (slicerZoneEffects.length < n) slicerZoneEffects.push('original');
  for (let z=0; z<n; z++) {
    const row = document.createElement('div');
    row.style.cssText='display:flex;align-items:center;gap:5px;font-size:0.68rem;color:var(--muted)';
    const label = document.createElement('span');
    label.style.cssText='min-width:52px;font-size:0.62rem';
    label.textContent = n===1 ? 'Bild' : z===0 ? (orient==='h'?'Oben':'Links') : z===n-1 ? (orient==='h'?'Unten':'Rechts') : `Mitte ${z}`;
    const sel = document.createElement('select');
    sel.style.cssText='flex:1;font-family:inherit;font-size:0.68rem;padding:2px 4px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);color:var(--text)';
    EFFECT_LIST.forEach(e => {
      const opt = document.createElement('option');
      opt.value=e; opt.textContent=EFFECT_LABELS[e]||e;
      if(slicerZoneEffects[z]===e) opt.selected=true;
      sel.appendChild(opt);
    });
    sel.addEventListener('change', () => { slicerZoneEffects[z]=sel.value; if(originalImage) applyEffect(); });
    row.appendChild(label); row.appendChild(sel);
    c.appendChild(row);
  }
}

function slicerUpdateOverlay() {
  const ov = document.getElementById('slicerOverlay');
  if (currentEffect !== 'slicer') { ov.style.display='none'; return; }
  ov.style.display = 'block';
  // Clear everything except the event listener wrappers
  Array.from(ov.children).forEach(c => c.remove());

  const orient = document.getElementById('sl-orient') ? document.getElementById('sl-orient').value : 'h';

  slicerLines.forEach((line, i) => {
    const lineEl = document.createElement('div');
    const handleEl = document.createElement('div');
    const pct = (line.pos * 100).toFixed(2) + '%';
    if (orient === 'h') {
      lineEl.className='sl-line sl-line-h'; lineEl.style.top=pct;
      handleEl.className='sl-handle sl-handle-h'; handleEl.style.top=pct;
    } else {
      lineEl.className='sl-line sl-line-v'; lineEl.style.left=pct;
      handleEl.className='sl-handle sl-handle-v'; handleEl.style.left=pct;
    }

    handleEl.addEventListener('pointerdown', e => {
      e.preventDefault(); e.stopPropagation();
      slicerDragging = i;
      handleEl.classList.add('dragging');
      handleEl.setPointerCapture(e.pointerId);

      const onMove = e2 => {
        const r = ov.getBoundingClientRect();
        let pos;
        if (orient === 'h') pos = Math.max(0.02, Math.min(0.98, (e2.clientY - r.top) / r.height));
        else pos = Math.max(0.02, Math.min(0.98, (e2.clientX - r.left) / r.width));
        slicerLines[i].pos = pos;
        // Update handle and line position live without full re-render
        const newPct = (pos*100).toFixed(2)+'%';
        if (orient==='h') { handleEl.style.top=newPct; lineEl.style.top=newPct; }
        else { handleEl.style.left=newPct; lineEl.style.left=newPct; }
        if (originalImage) applyEffect();
      };
      const onUp = () => {
        slicerDragging = null;
        handleEl.classList.remove('dragging');
        slicerLines.sort((a,b)=>a.pos-b.pos);
        slicerUpdateOverlay();
        slicerBuildZoneControls();
        handleEl.removeEventListener('pointermove', onMove);
        handleEl.removeEventListener('pointerup', onUp);
      };
      handleEl.addEventListener('pointermove', onMove);
      handleEl.addEventListener('pointerup', onUp);
    });

    ov.appendChild(lineEl);
    ov.appendChild(handleEl);
  });

  slicerBuildZoneControls();
}

function applySlicer() {
  if (!originalImage) return;
  const orient = document.getElementById('sl-orient').value;
  const W = canvas.width, H = canvas.height;

  // Sort lines
  const lines = [...slicerLines].sort((a,b)=>a.pos-b.pos);
  // Build zone boundaries
  const bounds = [0, ...lines.map(l=>l.pos), 1];
  const n = bounds.length - 1;

  // Ensure zone effects array has right length
  while (slicerZoneEffects.length < n) slicerZoneEffects.push('original');

  // Compose into a SEPARATE accumulator canvas. The draw-only effects
  // (ascii/riso/pixelate/halftone) repaint the WHOLE main canvas as scratch,
  // so if we composited straight onto the main canvas they would wipe the
  // zones rendered before them. Building the result off-screen keeps every
  // zone confined to its own slice, so each zone shows the effect selected
  // for it.
  const result = document.createElement('canvas'); result.width=W; result.height=H;
  const rctx = result.getContext('2d');

  for (let z=0; z<n; z++) {
    const from = bounds[z], to = bounds[z+1];
    const effect = slicerZoneEffects[z] || 'original';

    // Render zone effect into offscreen
    const off = document.createElement('canvas'); off.width=W; off.height=H;
    const offCtx = off.getContext('2d'); offCtx.drawImage(originalImage,0,0);

    if (effect !== 'original') {
      if (['ascii','risograph','pixelate','halftone','flash','neon','micro','lowpoly'].includes(effect)) {
        // These functions draw straight to the global main canvas, so use it
        // as scratch and copy the full result into this zone's buffer.
        const savedEffect = currentEffect; currentEffect = effect;
        canvas.width=W; canvas.height=H; ctx.drawImage(originalImage,0,0);
        if (effect==='ascii') applyASCII();
        else if (effect==='risograph') applyRisograph();
        else if (effect==='pixelate') applyPixelate();
        else if (effect==='halftone') applyHalftone();
        else if (effect==='flash') applyFlash();
        else if (effect==='neon') applyNeon();
        else if (effect==='micro') applyMicro();
        else if (effect==='lowpoly') applyLowpoly();
        offCtx.clearRect(0,0,W,H); offCtx.drawImage(canvas,0,0);
        currentEffect = savedEffect;
      } else {
        let imgData = offCtx.getImageData(0,0,W,H);
        if (effect==='duotone') imgData=applyDuotone(imgData);
        else if (effect==='dither') imgData=applyDither(imgData);
        else if (effect==='glitch') imgData=applyGlitch(imgData);
        else if (effect==='posterize') imgData=applyPosterize(imgData);
        else if (effect==='solarize') imgData=applySolarize(imgData);
        else if (effect==='threshold') imgData=applyThreshold(imgData);
        else if (effect==='blueprint') imgData=applyBlueprint(imgData);
        else if (effect==='gradmap') imgData=applyGradientMap(imgData);
        offCtx.putImageData(imgData,0,0);
      }
    }

    // Draw only this zone's slice from the offscreen buffer into the accumulator
    if (orient==='h') {
      const y1=Math.round(from*H), y2=Math.round(to*H);
      rctx.drawImage(off, 0,y1, W,y2-y1, 0,y1, W,y2-y1);
    } else {
      const x1=Math.round(from*W), x2=Math.round(to*W);
      rctx.drawImage(off, x1,0, x2-x1,H, x1,0, x2-x1,H);
    }
  }

  // Blit the finished composite back onto the main canvas
  canvas.width=W; canvas.height=H;
  ctx.clearRect(0,0,W,H);
  ctx.drawImage(result,0,0);
}

document.getElementById('sl-add-line').addEventListener('click', () => {
  if (slicerLines.length >= 2) return;
  const pos = slicerLines.length === 0 ? 0.5 : slicerLines[0].pos < 0.5 ? 0.75 : 0.25;
  slicerLines.push({pos});
  slicerLines.sort((a,b)=>a.pos-b.pos);
  while (slicerZoneEffects.length < slicerLines.length+1) slicerZoneEffects.push('original');
  slicerUpdateOverlay();
  if (originalImage) applyEffect();
});
document.getElementById('sl-clear-lines').addEventListener('click', () => {
  slicerLines=[]; slicerZoneEffects=['duotone'];
  slicerUpdateOverlay(); slicerBuildZoneControls();
  if (originalImage) applyEffect();
});
document.getElementById('sl-orient').addEventListener('change', () => {
  slicerLines=[]; slicerZoneEffects=['duotone'];
  slicerUpdateOverlay(); slicerBuildZoneControls();
  if (originalImage) applyEffect();
});

// ── Effect-Blend ───────────────────────────────────────
let blendCenterX = 0.5, blendCenterY = 0.5;

function applyEffectBlend() {
  const effectName = document.getElementById('bl-effect').value;
  const shape = document.getElementById('bl-shape').value;
  const radius = parseInt(document.getElementById('bl-radius').value) / 100;
  const soft = Math.max(0.01, parseInt(document.getElementById('bl-soft').value) / 100);
  const invert = document.getElementById('bl-invert').value === '1';
  const W = canvas.width, H = canvas.height;

  const orig = document.createElement('canvas'); orig.width=W; orig.height=H;
  orig.getContext('2d').drawImage(originalImage,0,0);

  const effCanvas = document.createElement('canvas'); effCanvas.width=W; effCanvas.height=H;
  const effCtx = effCanvas.getContext('2d');
  effCtx.drawImage(originalImage,0,0);

  if (['ascii','risograph','pixelate','halftone','flash','neon','micro','lowpoly'].includes(effectName)) {
    const saved = currentEffect; currentEffect = effectName;
    applyEffect(); effCtx.drawImage(canvas,0,0);
    ctx.drawImage(originalImage,0,0); currentEffect = saved;
  } else {
    let imgData = effCtx.getImageData(0,0,W,H);
    if (effectName==='duotone') imgData=applyDuotone(imgData);
    else if (effectName==='dither') imgData=applyDither(imgData);
    else if (effectName==='glitch') imgData=applyGlitch(imgData);
    else if (effectName==='posterize') imgData=applyPosterize(imgData);
    else if (effectName==='solarize') imgData=applySolarize(imgData);
    else if (effectName==='threshold') imgData=applyThreshold(imgData);
    else if (effectName==='blueprint') imgData=applyBlueprint(imgData);
    else if (effectName==='gradmap') imgData=applyGradientMap(imgData);
    effCtx.putImageData(imgData,0,0);
  }

  const origData = orig.getContext('2d').getImageData(0,0,W,H).data;
  const effData = effCtx.getImageData(0,0,W,H).data;
  const out = ctx.createImageData(W,H);
  const aspect = W/H;

  for (let y=0; y<H; y++) {
    for (let x=0; x<W; x++) {
      const nx=x/W, ny=y/H;
      let dist;
      if (shape==='radial') { const dx=(nx-blendCenterX)*aspect, dy=ny-blendCenterY; dist=Math.sqrt(dx*dx+dy*dy)/(radius*aspect); }
      else if (shape==='horizontal') dist=Math.abs(ny-blendCenterY)/radius;
      else dist=Math.abs(nx-blendCenterX)/radius;
      let t = Math.min(1,Math.max(0,(dist-1+soft)/soft));
      if (invert) t=1-t;
      const i=(y*W+x)*4;
      out.data[i]  =Math.round(effData[i]  *(1-t)+origData[i]  *t);
      out.data[i+1]=Math.round(effData[i+1]*(1-t)+origData[i+1]*t);
      out.data[i+2]=Math.round(effData[i+2]*(1-t)+origData[i+2]*t);
      out.data[i+3]=255;
    }
  }
  ctx.putImageData(out,0,0);
}

canvas.addEventListener('click', e => {
  if (brushActive) return;
  if (currentEffect !== 'blend') return;
  const r = canvas.getBoundingClientRect();
  blendCenterX = (e.clientX-r.left)/r.width;
  blendCenterY = (e.clientY-r.top)/r.height;
  document.getElementById('bl-center-display').textContent =
    `Zentrum: ${Math.round(blendCenterX*100)}% / ${Math.round(blendCenterY*100)}%`;
  applyEffect();
});

// ── Border ─────────────────────────────────────────────
function addBorder(bw, color) {
  if (bw <= 0) return;
  ctx.save();
  // Zustand von vorherigen Effekten sicher zuruecksetzen (sonst wuerde der
  // Rahmen z.B. eine hinterlassene Compositing-Operation oder ein Filter erben).
  ctx.globalCompositeOperation = 'source-over';
  ctx.filter = 'none';
  ctx.globalAlpha = 1;
  ctx.strokeStyle = color;
  ctx.lineWidth = bw;
  // Vollstaendig innen liegender Rahmen — die gesamte Dicke bleibt sichtbar.
  ctx.strokeRect(bw/2, bw/2, canvas.width - bw, canvas.height - bw);
  ctx.restore();
}

// ── Main apply ─────────────────────────────────────────
function applyEffect(){
  if(!originalImage) return;
  canvas.width=originalImage.width; canvas.height=originalImage.height;

  if (currentEffect==='slicer') { applySlicer(); }
  else if (currentEffect==='blend') { applyEffectBlend(); }
  else if (currentEffect==='none') { ctx.drawImage(originalImage,0,0); }
  else {
    const drawOnly=['ascii','risograph','pixelate','halftone','flash','neon','micro','lowpoly'];
    if(drawOnly.includes(currentEffect)){
      ctx.drawImage(originalImage,0,0);
      if(currentEffect==='ascii') { applyASCII(); }
      else if(currentEffect==='risograph') applyRisograph();
      else if(currentEffect==='pixelate') applyPixelate();
      else if(currentEffect==='halftone') applyHalftone();
      else if(currentEffect==='flash') applyFlash();
      else if(currentEffect==='neon') applyNeon();
      else if(currentEffect==='micro') applyMicro();
      else if(currentEffect==='lowpoly') applyLowpoly();
    } else {
      ctx.drawImage(originalImage,0,0);
      let imgData=ctx.getImageData(0,0,canvas.width,canvas.height);
      if(currentEffect==='duotone') imgData=applyDuotone(imgData);
      else if(currentEffect==='dither') imgData=applyDither(imgData);
      else if(currentEffect==='glitch') imgData=applyGlitch(imgData);
      else if(currentEffect==='posterize') imgData=applyPosterize(imgData);
      else if(currentEffect==='solarize') imgData=applySolarize(imgData);
      else if(currentEffect==='threshold') imgData=applyThreshold(imgData);
      else if(currentEffect==='blueprint') imgData=applyBlueprint(imgData);
      else if(currentEffect==='gradmap') imgData=applyGradientMap(imgData);
      ctx.putImageData(imgData,0,0);
    }
  }
  const bw=parseInt(document.getElementById('border-width').value);
  addBorder(bw, document.getElementById('border-color').value);
}

