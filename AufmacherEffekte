<script>
// ── State ─────────────────────────────────────────────
let originalImage = null;
let glitchSeed = Math.random();
let currentEffect = 'none';
const canvas = document.getElementById('mainCanvas');
const ctx = canvas.getContext('2d');

// ── Overlay / Pop-Out / Unschärfe-Hintergrund (State) ──
let sourceImage = null;      // unveraendertes Bild (nach Laden/Crop); Basis fuer Fill
let overlayId = null;        // gewaehlte Rubrik oder null
let overlayImg = null;       // geladenes Overlay-Bild
let overlayMask = null;      // Canvas WxH, weiss = sichtbar
let effectCache = null;      // Canvas WxH: Effektergebnis ohne Overlay/Rahmen (fuer schnelles Pinseln)
let brushActive = false;
let brushMode = 'erase';     // erase | paint
let ovBrushSize = 80;
let ovBrushHardness = 50;
let fillActive = false;
let fillBlur = 24;
let pristineImage = null;   // Bild wie geladen — Basis für „Original wiederherstellen"
let decoMode = 'none';      // none | overlay | border  (exklusiv)
let formatMode = 'none';    // none | crop | blur

// ── File loading ───────────────────────────────────────
const dropZone = document.getElementById('dropZone');
const fileInput = document.getElementById('fileInput');
dropZone.addEventListener('click', () => fileInput.click());
dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
dropZone.addEventListener('drop', e => {
  e.preventDefault(); dropZone.classList.remove('drag-over');
  if (e.dataTransfer.files[0]) loadFile(e.dataTransfer.files[0]);
});
fileInput.addEventListener('change', () => { if (fileInput.files[0]) loadFile(fileInput.files[0]); });
function loadFile(file) {
  const reader = new FileReader();
  reader.onload = e => {
    const img = new Image();
    img.onload = () => finishLoad(img);
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}
function finishLoad(img) {
  originalImage = img; sourceImage = img; pristineImage = img; fillActive = false;
  canvas.width = img.width; canvas.height = img.height;
  ctx.drawImage(img, 0, 0);
  document.getElementById('placeholder').style.display = 'none';
  document.getElementById('canvasWrap').style.display = 'block';
  overlayId = null; overlayImg = null; overlayMask = null; effectCache = null; brushActive = false;
  const rb=document.getElementById('restoreBtn'); if(rb) rb.disabled=false;
  setFormatMode('none'); setDecoMode('none');
  highlightOverlay(); updateFillUi();
  slicerUpdateOverlay();
