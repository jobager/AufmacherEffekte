// ── Helpers ────────────────────────────────────────────
function hexToRgb(hex){return[parseInt(hex.slice(1,3),16),parseInt(hex.slice(3,5),16),parseInt(hex.slice(5,7),16)]}
function showProcessing(v){document.getElementById('processingLabel').style.display=v?'block':'none'}
function seededRand(seed){let s=seed;return()=>{s=(s*1664525+1013904223)&0xFFFFFFFF;return(s>>>0)/0xFFFFFFFF}}

function applyGradientOverlay(ctx, W, H, gradA, gradB, gradDir, gradOpacity) {
  if (gradDir === 'none' || gradOpacity <= 0) return;
  let grad;
  if (gradDir==='lr') grad=ctx.createLinearGradient(0,0,W,0);
  else if (gradDir==='tb') grad=ctx.createLinearGradient(0,0,0,H);
  else if (gradDir==='diag') grad=ctx.createLinearGradient(0,0,W,H);
  else grad=ctx.createRadialGradient(W/2,H/2,0,W/2,H/2,Math.max(W,H)*0.7);
  grad.addColorStop(0,gradA); grad.addColorStop(1,gradB);
  ctx.save();
  ctx.globalAlpha = gradOpacity/100;
  ctx.fillStyle = grad;
  ctx.fillRect(0,0,W,H);
  ctx.restore();
}

function applyDuotone(imgData){
  const shadow=hexToRgb(document.getElementById('dt-shadow').value);
  const highlight=hexToRgb(document.getElementById('dt-highlight').value);
  const contrast=parseInt(document.getElementById('dt-contrast').value)/100;
  const d=imgData.data;
  for(let i=0;i<d.length;i+=4){
    let lum=0.299*d[i]+0.587*d[i+1]+0.114*d[i+2];
    lum=Math.min(255,Math.max(0,(lum-128)*(1+contrast)+128));
    const t=lum/255;
    d[i]=shadow[0]+(highlight[0]-shadow[0])*t;
    d[i+1]=shadow[1]+(highlight[1]-shadow[1])*t;
    d[i+2]=shadow[2]+(highlight[2]-shadow[2])*t;
  }
  return imgData;
}

const PALETTES={bw:[[0,0,0],[255,255,255]],gameboy:[[15,56,15],[48,98,48],[139,172,15],[155,188,15]],cga:[[0,0,0],[85,255,255],[255,85,255],[255,255,255]],sepia:[[28,18,8],[89,65,35],[160,120,70],[225,190,140]]};
function nearestColor(r,g,b,palette){let best=0,bestDist=Infinity;for(let i=0;i<palette.length;i++){const dr=r-palette[i][0],dg=g-palette[i][1],db=b-palette[i][2],dist=dr*dr+dg*dg+db*db;if(dist<bestDist){bestDist=dist;best=i;}}return palette[best];}
function quantize4(r,g,b){return[Math.round(r/85)*85,Math.round(g/85)*85,Math.round(b/85)*85]}

function applyDither(imgData){
  const algo=document.getElementById('dith-algo').value;
  const palName=document.getElementById('dith-palette').value;
  const W=imgData.width,H=imgData.height;
  const d=new Float32Array(imgData.data.length);
  for(let i=0;i<imgData.data.length;i++)d[i]=imgData.data[i];
  const palette=PALETTES[palName];
  const useColor=palName==='color4';
  if(algo==='bayer'){
    const bayer=[[0,8,2,10],[12,4,14,6],[3,11,1,9],[15,7,13,5]];
    for(let y=0;y<H;y++)for(let x=0;x<W;x++){
      const i=(y*W+x)*4,thresh=(bayer[y%4][x%4]/16-0.5)*80;
      const l=0.299*d[i]+0.587*d[i+1]+0.114*d[i+2]+thresh;
      const nc=useColor?quantize4(d[i]+thresh,d[i+1]+thresh,d[i+2]+thresh):nearestColor(l,l,l,palette);
      imgData.data[i]=nc[0];imgData.data[i+1]=nc[1];imgData.data[i+2]=nc[2];
    }
    return imgData;
  }
  if(algo==='threshold'){
    for(let i=0;i<d.length;i+=4){
      const lum=0.299*d[i]+0.587*d[i+1]+0.114*d[i+2];
      const nc=useColor?quantize4(d[i],d[i+1],d[i+2]):nearestColor(lum,lum,lum,palette);
      imgData.data[i]=nc[0];imgData.data[i+1]=nc[1];imgData.data[i+2]=nc[2];
    }
    return imgData;
  }
  const KERNELS={floyd:[[1,0,7/16],[1,-1,3/16],[1,1,1/16],[2,0,5/16]],atkinson:[[0,1,1/8],[0,2,1/8],[1,-1,1/8],[1,0,1/8],[1,1,1/8],[2,0,1/8]]};
  const kernel=KERNELS[algo]||KERNELS.floyd;
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){
    const i=(y*W+x)*4;
    const lum=0.299*d[i]+0.587*d[i+1]+0.114*d[i+2];
    const nc=useColor?quantize4(d[i],d[i+1],d[i+2]):nearestColor(lum,lum,lum,palette);
    const er=d[i]-nc[0],eg=d[i+1]-nc[1],eb=d[i+2]-nc[2];
    imgData.data[i]=nc[0];imgData.data[i+1]=nc[1];imgData.data[i+2]=nc[2];
    for(const[dy,dx,w]of kernel){
      const nx=x+dx,ny=y+dy;
      if(nx>=0&&nx<W&&ny>=0&&ny<H){const ni=(ny*W+nx)*4;d[ni]=Math.min(255,Math.max(0,d[ni]+er*w));d[ni+1]=Math.min(255,Math.max(0,d[ni+1]+eg*w));d[ni+2]=Math.min(255,Math.max(0,d[ni+2]+eb*w));}
    }
  }
  return imgData;
}

function applyGlitch(imgData){
  const intensity=parseInt(document.getElementById('gl-intensity').value);
  const rgbShift=parseInt(document.getElementById('gl-rgb').value);
  const scanPct=parseInt(document.getElementById('gl-scan').value)/100;
  const glType=document.getElementById('gl-type').value;
  const W=imgData.width,H=imgData.height;
  const src=new Uint8ClampedArray(imgData.data);
  let seed=Math.floor(glitchSeed*0xFFFFFF);
  const rand=()=>{seed=(seed*1664525+1013904223)&0xFFFFFF;return seed/0xFFFFFF};
  if(rgbShift>0)for(let y=0;y<H;y++)for(let x=0;x<W;x++){
    const i=(y*W+x)*4,sx=Math.min(W-1,x+rgbShift),si=(y*W+sx)*4;imgData.data[i]=src[si];
    const bx=Math.max(0,x-Math.floor(rgbShift/2)),bi=(y*W+bx)*4;imgData.data[i+2]=src[bi+2];
  }
  if(glType==='horizontal'||glType==='both'){
    for(let j=0;j<src.length;j++)src[j]=imgData.data[j];
    let y=0;while(y<H){const sliceH=Math.max(1,Math.floor(rand()*20));if(rand()<intensity/200){const shift=Math.floor((rand()-0.5)*intensity*3);for(let sy=y;sy<Math.min(y+sliceH,H);sy++)for(let x=0;x<W;x++){const nx=(x+shift+W)%W,di=(sy*W+x)*4,si2=(sy*W+nx)*4;imgData.data[di]=src[si2];imgData.data[di+1]=src[si2+1];imgData.data[di+2]=src[si2+2];}}y+=sliceH;}
  }
  if(glType==='noise'||glType==='both'){const noisePx=Math.floor(W*H*intensity/2000);for(let n=0;n<noisePx;n++){const x=Math.floor(rand()*W),y=Math.floor(rand()*H),i=(y*W+x)*4;imgData.data[i]=rand()<0.5?0:255;imgData.data[i+1]=rand()<0.5?0:255;imgData.data[i+2]=rand()<0.5?0:255;}}
  if(scanPct>0)for(let y=0;y<H;y+=2)for(let x=0;x<W;x++){const i=(y*W+x)*4;imgData.data[i]=Math.max(0,imgData.data[i]*(1-scanPct*.6));imgData.data[i+1]=Math.max(0,imgData.data[i+1]*(1-scanPct*.6));imgData.data[i+2]=Math.max(0,imgData.data[i+2]*(1-scanPct*.6));}
  return imgData;
}

function applyASCII(){
  const mode=document.getElementById('asc-mode').value;
  const charSize=parseInt(document.getElementById('asc-size').value);
  const weight=document.getElementById('asc-weight').value;
  const fg=document.getElementById('asc-fg').value;
  const bg=document.getElementById('asc-bg').value;
  const colorMix=parseInt(document.getElementById('asc-color').value)/100;
  const W=canvas.width,H=canvas.height;
  const CHARS={classic:['@','#','S','%','?','*','+',';',':',' '],block:['█','▓','▒','░',' '],minimal:['█','▪',' ']};
  const chars=CHARS[mode];
  const tmp=document.createElement('canvas');tmp.width=W;tmp.height=H;
  const tc=tmp.getContext('2d');tc.drawImage(originalImage,0,0);
  const src=tc.getImageData(0,0,W,H).data;
  ctx.fillStyle=bg;ctx.fillRect(0,0,W,H);
  ctx.font=`${weight} ${charSize}px "Courier New",monospace`;ctx.textBaseline='top';
  const cellW=charSize*0.6,cellH=charSize;
  for(let y=0;y<H;y+=cellH)for(let x=0;x<W;x+=cellW){
    const px=Math.min(W-1,Math.round(x+cellW/2)),py=Math.min(H-1,Math.round(y+cellH/2));
    const i=(py*W+px)*4;
    const r=src[i],g=src[i+1],b=src[i+2];
    const lum=0.299*r+0.587*g+0.114*b;
    const ci=Math.floor((lum/255)*(chars.length-1));
    const fgRgb=hexToRgb(fg);
    if(colorMix>0){const mr=Math.round(fgRgb[0]*(1-colorMix)+r*colorMix),mg=Math.round(fgRgb[1]*(1-colorMix)+g*colorMix),mb=Math.round(fgRgb[2]*(1-colorMix)+b*colorMix);ctx.fillStyle=`rgb(${mr},${mg},${mb})`;}
    else ctx.fillStyle=fg;
    ctx.fillText(chars[ci],x,y);
  }
}

function applyRisograph(){
  const c1=hexToRgb(document.getElementById('riso-c1').value);
  const c2=hexToRgb(document.getElementById('riso-c2').value);
  const offset=parseInt(document.getElementById('riso-offset').value);
  const grain=parseInt(document.getElementById('riso-grain').value);
  const W=canvas.width,H=canvas.height;
  const tmp=document.createElement('canvas');tmp.width=W;tmp.height=H;
  const tc=tmp.getContext('2d');tc.drawImage(originalImage,0,0);
  const src=tc.getImageData(0,0,W,H).data;
  const out=ctx.createImageData(W,H);const d=out.data;
  const rand=seededRand(42);
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){
    const i=(y*W+x)*4;
    const lum1=1-(0.299*src[i]+0.587*src[i+1]+0.114*src[i+2])/255;
    const ox=Math.max(0,Math.min(W-1,x-offset)),oy=Math.max(0,Math.min(H-1,y-offset));
    const i2=(oy*W+ox)*4;
    const lum2=1-(0.299*src[i2]+0.587*src[i2+1]+0.114*src[i2+2])/255;
    const noise=grain>0?(rand()-0.5)*grain/100:0;
    const t1=Math.min(1,Math.max(0,lum1+noise)),t2=Math.min(1,Math.max(0,lum2+noise));
    d[i]=Math.round(255*(1-(1-c1[0]/255*t1)*(1-c2[0]/255*t2)));
    d[i+1]=Math.round(255*(1-(1-c1[1]/255*t1)*(1-c2[1]/255*t2)));
    d[i+2]=Math.round(255*(1-(1-c1[2]/255*t1)*(1-c2[2]/255*t2)));
    d[i+3]=255;
  }
  ctx.putImageData(out,0,0);
}

function applyPosterize(imgData){
  const levels=parseInt(document.getElementById('pos-levels').value);
  const mode=document.getElementById('pos-mode').value;
  const d=imgData.data;const step=255/(levels-1);
  for(let i=0;i<d.length;i+=4){
    if(mode==='lum'){const lum=Math.round((0.299*d[i]+0.587*d[i+1]+0.114*d[i+2])/step)*step;d[i]=d[i+1]=d[i+2]=Math.min(255,lum);}
    else{d[i]=Math.round(d[i]/step)*step;d[i+1]=Math.round(d[i+1]/step)*step;d[i+2]=Math.round(d[i+2]/step)*step;}
  }
  return imgData;
}

function applySolarize(imgData){
  const thresh=parseInt(document.getElementById('sol-thresh').value);
  const mode=document.getElementById('sol-mode').value;
  const strength=parseInt(document.getElementById('sol-strength').value)/100;
  const d=imgData.data;
  for(let i=0;i<d.length;i+=4){
    if(mode==='classic'){d[i]=d[i]>thresh?255-d[i]:d[i];d[i+1]=d[i+1]>thresh?255-d[i+1]:d[i+1];d[i+2]=d[i+2]>thresh?255-d[i+2]:d[i+2];}
