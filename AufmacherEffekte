slicerBuildZoneControls();
// ── Interaktive Tour (Spotlight) ───────────────────────────────
const TOUR_KEY = 'aufmacher_tour_seen_v1';
const TOUR_STEPS = [
  { sel:null, title:'Schnell zum Aufmacher', text:'Willkommen! In wenigen Schritten wird aus einem Foto ein Aufmacher – ganz ohne KI-Einheitsbrei. Der Ablauf folgt der Leiste von oben nach unten.' },
  { sel:'#bild-section', title:'1 · Bild laden', text:'Zieh ein Bild in die Fläche oder klick sie an. „Original wiederherstellen“ setzt jederzeit auf das ungefilterte Ausgangsbild zurück.' },
  { sel:'#format-section', title:'2 · Format (16:9)', text:'Zuerst ins Format bringen: entweder einen 16:9-Ausschnitt aufziehen oder – für Hochkant – einen unscharfen Hintergrundrand mit wählbarer Füllfarbe erzeugen.' },
  { sel:'#fx-tabs', title:'3 · Effekt wählen', text:'Duotone, Halftone, Dither, Glitch, Blueprint, Neon, Low-Poly und mehr. „Ohne“ zeigt das Bild unbearbeitet.' },
  { sel:'#effect-controls', title:'Feinjustieren & Presets', text:'Regler und Farben passen den Effekt live an; eigene Einstellungen lassen sich als Preset speichern.' },
  { sel:'#meta-tabs', title:'Slicer & Effekt-Verlauf', text:'Der Slicer teilt das Bild in Zonen mit je eigenem Effekt. Der Effekt-Verlauf blendet einen Effekt weich ins Original.' },
  { sel:'#deco-section', title:'4 · Rahmen', text:'Optional eine farbige Außenkante in beliebiger Dicke um das Bild.' },
  { sel:'#export-actions', title:'5 · Speichern', text:'Fertig? Als PNG herunterladen. Diese Tour findest du jederzeit oben rechts unter „? Tour“ wieder.' },
];
let tourIdx = 0;
let tourEls = null;

function buildTourDom(){
  if(tourEls) return tourEls;
  const backdrop=document.createElement('div'); backdrop.id='tourBackdrop';
  const spot=document.createElement('div'); spot.id='tourSpot';
  const card=document.createElement('div'); card.id='tourCard';
  card.innerHTML=`<div class="tour-head"><button id="tourSkip" type="button">Überspringen ✕</button></div>
    <h3></h3><p></p>
    <div class="tour-foot"><div class="tour-dots"></div>
    <div class="tour-btns"><button id="tourPrev" type="button">← Zurück</button><button id="tourNext" type="button" class="primary">Weiter →</button></div></div>`;
  document.body.append(backdrop, spot, card);
  card.querySelector('#tourSkip').addEventListener('click', endTour);
  card.querySelector('#tourPrev').addEventListener('click', ()=>gotoTourStep(tourIdx-1));
  card.querySelector('#tourNext').addEventListener('click', ()=>{ if(tourIdx>=TOUR_STEPS.length-1) endTour(); else gotoTourStep(tourIdx+1); });
  backdrop.addEventListener('click', (e)=>{ e.stopPropagation(); }); // Klicks aufs UI abfangen
  window.addEventListener('resize', positionTour);
  document.addEventListener('keydown', (e)=>{
    if(!tourEls || tourEls.card.style.display==='none') return;
    if(e.key==='Escape') endTour();
    else if(e.key==='ArrowRight'){ if(tourIdx>=TOUR_STEPS.length-1) endTour(); else gotoTourStep(tourIdx+1); }
    else if(e.key==='ArrowLeft') gotoTourStep(tourIdx-1);
  });
  tourEls={backdrop,spot,card};
  return tourEls;
}
function startTour(){
  buildTourDom();
  tourEls.backdrop.style.display='block';
  tourEls.spot.style.display='block';
  tourEls.card.style.display='block';
  gotoTourStep(0);
}
function endTour(){
  if(!tourEls) return;
  tourEls.backdrop.style.display='none';
  tourEls.spot.style.display='none';
  tourEls.card.style.display='none';
  document.querySelector('.sidebar')?.scrollTo(0,0);
  try{ localStorage.setItem(TOUR_KEY,'1'); }catch(e){}
}
function gotoTourStep(i){
  tourIdx=Math.max(0,Math.min(TOUR_STEPS.length-1,i));
  const step=TOUR_STEPS[tourIdx];
  const card=tourEls.card;
  card.querySelector('h3').textContent=step.title;
  card.querySelector('p').textContent=step.text;
  const dots=card.querySelector('.tour-dots'); dots.innerHTML='';
  TOUR_STEPS.forEach((_,k)=>{ const d=document.createElement('div'); d.className='tour-dot'+(k===tourIdx?' on':''); dots.appendChild(d); });
  card.querySelector('#tourPrev').disabled = tourIdx===0;
  card.querySelector('#tourNext').textContent = tourIdx===TOUR_STEPS.length-1 ? 'Fertig ✓' : 'Weiter →';
  const el = step.sel ? document.querySelector(step.sel) : null;
  if(el) el.scrollIntoView({block:'center', inline:'nearest'});
  requestAnimationFrame(positionTour);
}
function positionTour(){
  if(!tourEls || tourEls.card.style.display==='none') return;
  const step=TOUR_STEPS[tourIdx];
  const spot=tourEls.spot, card=tourEls.card;
  const el = step.sel ? document.querySelector(step.sel) : null;
  const vw=window.innerWidth, vh=window.innerHeight, pad=8, gap=14;
  const cw=card.offsetWidth||300, ch=card.offsetHeight||160;
  if(!el){
    spot.classList.add('no-target');
    card.style.left=Math.round((vw-cw)/2)+'px';
    card.style.top=Math.round((vh-ch)/2)+'px';
    return;
  }
  spot.classList.remove('no-target');
  const r=el.getBoundingClientRect();
  const x=Math.max(0,r.left-pad), y=Math.max(0,r.top-pad);
  const w=Math.min(vw,r.right+pad)-x, h=Math.min(vh,r.bottom+pad)-y;
  spot.style.left=x+'px'; spot.style.top=y+'px'; spot.style.width=w+'px'; spot.style.height=h+'px';
  let cx, cy;
  if(r.right+gap+cw <= vw){ cx=r.right+gap; cy=r.top; }
  else if(r.bottom+gap+ch <= vh){ cx=r.left; cy=r.bottom+gap; }
  else if(r.top-gap-ch >= 0){ cx=r.left; cy=r.top-gap-ch; }
  else { cx=vw-cw-gap; cy=gap; }
  cx=Math.max(gap,Math.min(vw-cw-gap,cx));
  cy=Math.max(gap,Math.min(vh-ch-gap,cy));
  card.style.left=Math.round(cx)+'px'; card.style.top=Math.round(cy)+'px';
}
document.getElementById('helpBtn').addEventListener('click', startTour);

// Auto-Start bei erstem Besuch
if (!localStorage.getItem(TOUR_KEY)) setTimeout(startTour, 400);

