<!DOCTYPE html>
<!-- saved from url=(0055)file:///Users/jo/Downloads/aufmacher-effekte-v11_4.html -->
<html lang="de"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aufmacher-Effekte v21 · ohne Overlays</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@400;700&display=swap');
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#f0ede8;--surface:#faf9f7;--border:#d8d4cc;--text:#1a1917;--muted:#7a7670;--accent:#c8410a;--panel:#edebe6;--radius:5px}
body{font-family:'DM Mono',monospace;background:var(--bg);color:var(--text);height:100vh;display:flex;flex-direction:column;overflow:hidden}
header{border-bottom:1px solid var(--border);background:var(--surface);flex-shrink:0}
#header-top{display:flex;align-items:stretch;gap:0}
#header-title{font-family:'Syne',sans-serif;font-weight:700;font-size:1.15rem;line-height:1.15;padding:0.6rem 1.2rem;border-right:1px solid var(--border);display:flex;align-items:center;white-space:nowrap;min-width:max-content}
#header-links-col{display:flex;flex-direction:column;flex:1;overflow:hidden}
#header-row1,#header-row2{display:flex;align-items:center;gap:4px;padding:0.35rem 1rem;flex-wrap:wrap}
#header-row1{border-bottom:1px solid var(--border)}
.row-label{font-size:0.62rem;color:var(--muted);white-space:nowrap;margin-right:2px}
.src-tab{font-family:'DM Mono',monospace;font-size:0.63rem;padding:2px 8px;border:1px solid var(--border);border-radius:var(--radius);cursor:pointer;background:var(--panel);color:var(--muted);transition:all 0.1s}
.src-tab:hover,.src-tab.active{background:var(--accent);border-color:var(--accent);color:#fff}
.hlink-add{font-family:'DM Mono',monospace;font-size:0.63rem;padding:2px 8px;border:1px solid var(--border);border-radius:var(--radius);background:none;color:var(--muted);cursor:pointer}
.hlink-add:hover{border-color:var(--accent);color:var(--accent)}
.hlink{font-size:0.65rem;color:var(--accent);text-decoration:none;padding:1px 6px;border:1px solid var(--border);border-radius:var(--radius);background:var(--panel);white-space:nowrap;transition:all 0.1s}
.hlink:hover{border-color:var(--accent);background:#fdf3ee}
header span{font-size:0.68rem;color:var(--muted)}
.app{display:grid;grid-template-columns:270px 1fr;overflow:hidden;flex:1;min-height:0}
.sidebar{background:var(--surface);border-right:1px solid var(--border);overflow-y:auto;display:flex;flex-direction:column;gap:0}
.sidebar-section{padding:0.9rem 1rem;border-bottom:1px solid var(--border)}
.section-label{font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-bottom:0.5rem}

/* Drop zone */
.drop-zone{border:1.5px dashed var(--border);border-radius:var(--radius);padding:0.9rem;text-align:center;cursor:pointer;font-size:0.68rem;color:var(--muted);line-height:1.7;transition:all 0.15s}
.drop-zone:hover,.drop-zone.drag-over{border-color:var(--accent);background:#fdf3ee;color:var(--accent)}
.drop-zone input{display:none}

/* Link panel */
.link-list{display:flex;flex-direction:column;gap:3px;margin-bottom:6px}
.link-item{display:flex;align-items:center;gap:3px}
.link-item a{flex:1;font-size:0.65rem;padding:0.28rem 0.5rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--panel);color:var(--accent);text-decoration:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;transition:all 0.1s}
.link-item a:hover{border-color:var(--accent);background:#fdf3ee}
.link-item .del-link{font-size:0.6rem;padding:0.25rem 0.4rem;border:1px solid var(--border);border-radius:var(--radius);cursor:pointer;background:none;color:var(--muted);flex-shrink:0}
.link-item .del-link:hover{color:#c00;border-color:#c00}
.link-edit-area{display:none;flex-direction:column;gap:4px;margin-top:4px}
.link-edit-area.open{display:flex}
.link-edit-area input{font-family:'DM Mono',monospace;font-size:0.68rem;padding:0.3rem 0.5rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);color:var(--text);width:100%}
.link-edit-area input:focus{outline:none;border-color:var(--accent)}
.link-edit-row{display:flex;gap:3px}
.link-edit-row button{font-family:'DM Mono',monospace;font-size:0.65rem;padding:0.28rem 0.6rem;border:1px solid var(--border);border-radius:var(--radius);cursor:pointer;background:var(--panel);color:var(--text);white-space:nowrap}
.link-edit-row button:hover{border-color:var(--accent);color:var(--accent)}
.link-toggle{font-family:'DM Mono',monospace;font-size:0.65rem;padding:0.28rem 0.5rem;border:1px solid var(--border);border-radius:var(--radius);cursor:pointer;background:var(--panel);color:var(--muted);width:100%;text-align:left;transition:all 0.1s}
.link-toggle:hover{border-color:var(--accent);color:var(--accent)}

/* Effect tabs */
.effect-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:3px}
.tab-btn{padding:0.35rem 0.1rem;font-family:'DM Mono',monospace;font-size:0.62rem;background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);cursor:pointer;color:var(--muted);transition:all 0.1s;text-align:center}
.tab-btn:hover{border-color:var(--accent);color:var(--text)}
.tab-btn.active{background:var(--accent);border-color:var(--accent);color:#fff}

.controls{display:flex;flex-direction:column;gap:0.7rem}
.control-row{display:flex;flex-direction:column;gap:0.25rem}
.control-row label{font-size:0.67rem;color:var(--muted);display:flex;justify-content:space-between}
.control-row label span{color:var(--text);font-weight:500}
input[type=range]{width:100%;height:3px;accent-color:var(--accent);cursor:pointer}
.color-pair{display:grid;grid-template-columns:1fr 1fr;gap:5px}
.color-swatch{display:flex;flex-direction:column;gap:2px;font-size:0.62rem;color:var(--muted)}
.color-swatch input[type=color]{width:100%;height:26px;border:1px solid var(--border);border-radius:var(--radius);cursor:pointer;padding:2px;background:var(--surface)}
select{width:100%;font-family:'DM Mono',monospace;font-size:0.7rem;padding:0.3rem 0.5rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);color:var(--text);cursor:pointer}
.preset-row{display:grid;grid-template-columns:repeat(3,1fr);gap:3px}
.preset-btn{font-family:'DM Mono',monospace;font-size:0.58rem;padding:0.28rem 0.1rem;border:1px solid var(--border);border-radius:var(--radius);cursor:pointer;background:var(--panel);color:var(--muted);text-align:center;transition:all 0.1s}
.preset-btn:hover{border-color:var(--accent);color:var(--accent)}

/* Custom presets */
.custom-presets{display:flex;flex-direction:column;gap:4px}
.custom-preset-item{display:flex;align-items:center;gap:3px}
.custom-preset-item button{flex:1;font-family:'DM Mono',monospace;font-size:0.62rem;padding:0.28rem 0.4rem;border:1px solid var(--border);border-radius:var(--radius);cursor:pointer;background:var(--panel);color:var(--text);text-align:left;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.custom-preset-item button:hover{border-color:var(--accent)}
.del-preset{font-size:0.6rem;padding:0.25rem 0.4rem;border:1px solid var(--border);border-radius:var(--radius);cursor:pointer;background:none;color:var(--muted)}
.del-preset:hover{color:#c00;border-color:#c00}
.save-preset-row{display:flex;gap:3px;margin-top:4px}
.save-preset-row input{flex:1;font-family:'DM Mono',monospace;font-size:0.68rem;padding:0.28rem 0.4rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);color:var(--text)}
.save-preset-row input:focus{outline:none;border-color:var(--accent)}
.save-preset-row button{font-family:'DM Mono',monospace;font-size:0.68rem;padding:0.28rem 0.6rem;border:1px solid var(--border);border-radius:var(--radius);cursor:pointer;background:var(--panel);color:var(--text);white-space:nowrap}
.save-preset-row button:hover{border-color:var(--accent);color:var(--accent)}

/* Border controls */
.effect-panel.active{display:flex;flex-direction:column;gap:0.7rem}

/* Actions */
.actions{padding:0.9rem 1rem;margin-top:auto;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:5px;background:var(--surface)}
.btn{font-family:'DM Mono',monospace;font-size:0.7rem;padding:0.5rem 1rem;border-radius:var(--radius);cursor:pointer;transition:all 0.1s;border:1px solid var(--border);background:var(--panel);color:var(--text);width:100%;text-align:center}
.btn:hover{border-color:var(--accent);color:var(--accent)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
.btn.primary:hover{opacity:0.88}
.btn-row{display:grid;grid-template-columns:1fr 1fr;gap:5px}

/* Border controls */
.border-row{display:grid;grid-template-columns:1fr 1fr;gap:6px;align-items:end}
.effect-panel{display:none}
/* Canvas area */
.canvas-area{display:flex;align-items:center;justify-content:center;background:#e0ddd7;background-image:repeating-conic-gradient(#d0cdc7 0% 25%,transparent 0% 50%);background-size:16px 16px;position:relative;overflow:hidden;user-select:none}
.canvas-wrap{position:relative;display:inline-block}
canvas{display:block;max-width:90vw;max-height:85vh;box-shadow:0 4px 32px rgba(0,0,0,0.2)}
.placeholder{text-align:center;color:var(--muted);font-size:0.78rem;line-height:2.2;padding:2rem}
.placeholder strong{display:block;font-family:'Syne',sans-serif;font-size:1.1rem;color:var(--text);margin-bottom:0.3rem}
.processing{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);font-size:0.68rem;color:var(--muted);background:var(--surface);padding:4px 14px;border-radius:20px;border:1px solid var(--border);display:none;pointer-events:none}
.source-tabs-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:3px}
.src-tab{font-family:'DM Mono',monospace;font-size:0.65rem;padding:0.3rem 0.2rem;border:1px solid var(--border);border-radius:var(--radius);cursor:pointer;background:var(--panel);color:var(--muted);text-align:center;transition:all 0.1s}
.src-tab:hover,.src-tab.active{background:var(--accent);border-color:var(--accent);color:#fff}
.meta-unknown{color:#c8410a;font-weight:500}
/* Crop overlay */
.crop-shade{position:absolute;background:rgba(0,0,0,0.5);pointer-events:none}
#cropRect{position:absolute;border:2px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,0.5);pointer-events:none}
.crop-bar{display:none} /* moved to sidebar actions */
/* Slicer overlay */
#slicerOverlay{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;display:none}
.sl-handle{position:absolute;background:rgba(255,255,255,0.85);border:2px solid var(--accent);z-index:5;pointer-events:all;transition:background 0.1s}
.sl-handle:hover,.sl-handle.dragging{background:var(--accent)}
.sl-handle-h{left:0;right:0;height:10px;margin-top:-5px;cursor:ns-resize}
.sl-handle-v{top:0;bottom:0;width:10px;margin-left:-5px;cursor:ew-resize}
.sl-line{position:absolute;background:rgba(200,65,10,0.6);pointer-events:none}
.sl-line-h{left:0;right:0;height:2px}
.sl-line-v{top:0;bottom:0;width:2px}
/* Responsive: unter 800px Controls über das Bild stapeln */
@media (max-width:800px){
  body{height:auto;min-height:100vh;overflow-x:hidden;overflow-y:auto}
  .app{grid-template-columns:1fr;flex:none;overflow:visible;min-height:0}
  .sidebar{border-right:none;border-bottom:2px solid var(--border);overflow:visible}
  .sidebar-section{border-bottom:1px solid var(--border)}
  .canvas-area{min-height:60vh;overflow:visible}
  canvas{max-width:96vw;max-height:70vh}
  .actions{margin-top:0}
}
/* Overlay (Rubrik) + Pop-Out-Pinsel + Unschärfe-Hintergrund */
.ov-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;margin-bottom:8px}
.ov-tile{position:relative;font-family:'DM Mono',monospace;font-size:0.58rem;color:#cfd6e6;background:#2a3550;border:1px solid var(--border);border-radius:var(--radius);cursor:pointer;padding:0;overflow:hidden;aspect-ratio:16/9;display:flex;align-items:flex-end;justify-content:center}
.ov-tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:3px}
.ov-tile span{position:relative;z-index:1;background:rgba(10,15,30,0.6);width:100%;text-align:center;padding:1px 0}
.ov-tile[data-ov="__none__"]{background:var(--panel);color:var(--muted);align-items:center}
.ov-tile:hover{border-color:var(--accent)}
.ov-tile.active{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent) inset}
.ov-brush{display:flex;flex-direction:column;gap:0.55rem;margin-top:2px}
.ov-brush.disabled{opacity:0.45;pointer-events:none}
.ov-toggle.active{background:var(--accent);border-color:var(--accent);color:#fff}
.seg{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:3px}
.seg-btn{font-family:'DM Mono',monospace;font-size:0.62rem;padding:0.3rem 0.1rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--panel);color:var(--muted);cursor:pointer;text-align:center;transition:all 0.1s}
.seg-btn:hover{border-color:var(--accent);color:var(--text)}
.seg-btn.active{background:var(--accent);border-color:var(--accent);color:#fff}
.btn.active{background:var(--accent);border-color:var(--accent);color:#fff}
/* Sidebar-Reihenfolge: Bild → Format → Effekt → Feineinstellung → Overlay/Rahmen → Export */
#bild-section{order:1}
#format-section{order:2}
#effect-section{order:3}
#effect-controls{order:4}
#meta-section{order:5}
#deco-section{order:6}
.actions{order:7}
.fmt-panel{display:flex;flex-direction:column;gap:0.6rem;margin-top:6px}
.fmt-hint{font-size:0.63rem;color:var(--muted);line-height:1.45;margin:0}
#header-actions{margin-left:auto;display:flex;align-items:center;padding:0 1rem}
/* Pop-Out-Pinsel: Kreisvorschau */
#brushPreview{position:absolute;border:2px solid var(--accent);border-radius:50%;pointer-events:none;transform:translate(-50%,-50%);display:none;z-index:10;box-shadow:0 0 0 1px rgba(255,255,255,0.6)}
/* Interaktive Tour (Spotlight) */
#tourBackdrop{position:fixed;inset:0;z-index:2000;background:transparent}
#tourSpot{position:fixed;z-index:2001;border-radius:8px;border:2px solid var(--accent);box-shadow:0 0 0 9999px rgba(15,18,24,0.68);pointer-events:none;transition:left .25s ease,top .25s ease,width .25s ease,height .25s ease}
#tourSpot.no-target{left:50%;top:50%;width:0;height:0;border-color:transparent}
#tourCard{position:fixed;z-index:2002;width:min(320px,86vw);background:var(--surface);border:1px solid var(--border);border-radius:10px;box-shadow:0 8px 40px rgba(0,0,0,.35);padding:1rem 1.1rem;font-family:'DM Mono',monospace;transition:left .2s ease,top .2s ease}
#tourCard h3{font-family:'Syne',sans-serif;font-weight:700;font-size:1rem;margin-bottom:0.45rem;color:var(--text)}
#tourCard p{font-size:0.75rem;line-height:1.6;color:var(--text);margin:0 0 0.85rem}
#tourCard .tour-foot{display:flex;align-items:center;justify-content:space-between;gap:8px}
#tourCard .tour-dots{display:flex;gap:5px;flex-wrap:wrap;max-width:120px}
#tourCard .tour-dot{width:6px;height:6px;border-radius:50%;background:var(--border)}
#tourCard .tour-dot.on{background:var(--accent)}
#tourCard .tour-btns{display:flex;gap:6px}
#tourCard button{font-family:'DM Mono',monospace;font-size:0.7rem;padding:0.35rem 0.7rem;border-radius:var(--radius);border:1px solid var(--border);background:var(--panel);color:var(--text);cursor:pointer}
#tourCard button.primary{background:var(--accent);border-color:var(--accent);color:#fff}
#tourCard button:disabled{opacity:0.4;cursor:default}
.tour-head{display:flex;justify-content:flex-end;margin:-2px -2px 2px}
#tourSkip{font-size:0.62rem;color:var(--muted);background:none;border:none;cursor:pointer;padding:2px}
</style>
</head>
<body>
<header>
  <div id="header-top">
    <div id="header-title">Aufmacher-<br>Effekte</div>
    <div id="header-actions">
      <button id="helpBtn" class="hlink-add" title="Kurze Einführung / Tour">? Tour</button>
    </div>
  </div>
</header>
<div class="app">
<div class="sidebar">

  <!-- BILD -->
  <div class="sidebar-section" id="bild-section">
    <div class="section-label">Bild</div>
    <div class="drop-zone" id="dropZone">
      <input type="file" id="fileInput" accept="image/*">
      Datei hierher ziehen oder klicken
    </div>
    <button class="btn" id="restoreBtn" style="margin-top:6px" disabled>Original wiederherstellen</button>
  </div>

  <!-- EFFECTS -->
  <div class="sidebar-section" id="effect-section">
    <div class="section-label">Effekt</div>
    <div class="effect-tabs" id="fx-tabs" style="grid-template-columns:repeat(4,1fr)">
      <button class="tab-btn active" data-effect="none">Ohne</button>
      <button class="tab-btn" data-effect="duotone">Duotone</button>
      <button class="tab-btn" data-effect="halftone">Halftone</button>
      <button class="tab-btn" data-effect="dither">Dither</button>
      <button class="tab-btn" data-effect="glitch">Glitch</button>
      <button class="tab-btn" data-effect="ascii">ASCII</button>
      <button class="tab-btn" data-effect="risograph">Riso</button>
      <button class="tab-btn" data-effect="posterize">Poster</button>
      <button class="tab-btn" data-effect="solarize">Solar</button>
      <button class="tab-btn" data-effect="pixelate">Pixel</button>
      <button class="tab-btn" data-effect="threshold">Threshold</button>
      <button class="tab-btn" data-effect="blueprint">Blueprint</button>
      <button class="tab-btn" data-effect="gradmap">Verlauf</button>
      <button class="tab-btn" data-effect="flash">Blitz</button>
      <button class="tab-btn" data-effect="neon">Neon</button>
      <button class="tab-btn" data-effect="micro">Technik</button>
      <button class="tab-btn" data-effect="lowpoly">Low-Poly</button>
    </div>
  </div>

  <!-- EFFECT PANELS -->
  <div class="sidebar-section" id="effect-controls">

    <div class="effect-panel controls" id="panel-duotone">
      <div class="section-label">Farben</div>
      <div class="color-pair">
        <div class="color-swatch">Schatten<input type="color" id="dt-shadow" value="#1a2e6e"></div>
        <div class="color-swatch">Licht<input type="color" id="dt-highlight" value="#f5a623"></div>
      </div>
      <div class="preset-row">
        <button class="preset-btn" data-shadow="#1a2e6e" data-highlight="#f5a623">Blau/Gold</button>
        <button class="preset-btn" data-shadow="#2d1b4e" data-highlight="#ff6b6b">Lila/Rot</button>
        <button class="preset-btn" data-shadow="#0d3d2b" data-highlight="#c8f04a">Grün/Lime</button>
        <button class="preset-btn" data-shadow="#1a1a1a" data-highlight="#f0e6d0">S/W Creme</button>
        <button class="preset-btn" data-shadow="#5c1a1a" data-highlight="#ffd166">Dunkel/Gelb</button>
        <button class="preset-btn" data-shadow="#003049" data-highlight="#fcbf49">Nacht/Sand</button>
      </div>
      <div class="control-row"><label>Kontrast <span id="dt-contrast-val">50</span></label><input type="range" id="dt-contrast" min="0" max="100" value="50" step="1"></div>
    </div>

    <div class="effect-panel controls" id="panel-dither">
      <select id="dith-algo"><option value="floyd">Floyd-Steinberg</option><option value="atkinson">Atkinson</option><option value="bayer">Bayer</option><option value="threshold">Schwellenwert</option></select>
      <select id="dith-palette"><option value="bw">Schwarzweiß</option><option value="gameboy">Game Boy</option><option value="cga">CGA</option><option value="sepia">Sepia</option><option value="color4">4-Bit Farbe</option></select>
      <div class="control-row"><label>Skalierung <span id="dith-scale-val">1</span>×</label><input type="range" id="dith-scale" min="1" max="8" value="1" step="1"></div>
    </div>

    <div class="effect-panel controls" id="panel-glitch">
      <div class="control-row"><label>Intensität <span id="gl-intensity-val">40</span></label><input type="range" id="gl-intensity" min="5" max="100" value="40" step="1"></div>
      <div class="control-row"><label>RGB-Shift <span id="gl-rgb-val">8</span></label><input type="range" id="gl-rgb" min="0" max="40" value="8" step="1"></div>
      <div class="control-row"><label>Scan-Linien <span id="gl-scan-val">30</span>%</label><input type="range" id="gl-scan" min="0" max="100" value="30" step="1"></div>
      <select id="gl-type"><option value="horizontal">Horizontal-Slices</option><option value="noise">Pixel-Noise</option><option value="both">Kombiniert</option></select>
      <button class="btn" id="gl-reseed">↻ Neue Variante</button>
    </div>

    <div class="effect-panel controls" id="panel-ascii">
      <select id="asc-mode"><option value="block">Block-Zeichen (█▓▒░)</option><option value="classic">Klassisch (@#S%?*+;:,.)</option><option value="minimal">Minimal (█ · )</option></select>
      <div class="control-row"><label>Zeichengröße <span id="asc-size-val">8</span>px</label><input type="range" id="asc-size" min="4" max="24" value="8" step="2"></div>
      <div class="control-row" id="asc-weight-row" style="display: none;"><label>Strichstärke <span id="asc-weight-val">400</span></label><input type="range" id="asc-weight" min="100" max="900" value="400" step="100"></div>
      <div class="color-pair">
        <div class="color-swatch">Zeichen<input type="color" id="asc-fg" value="#1a1917"></div>
