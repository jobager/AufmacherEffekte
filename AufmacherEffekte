// ── Overlay (Rubrik) + Pop-Out-Pinsel + Unschärfe-Hintergrund ──────────
const OVERLAY_DATA = {};
const OVERLAY_LIST = [
  {id:'faq',name:'FAQ'},
  {id:'wtf',name:'WTF'},
  {id:'kommentar',name:'Kommentar'},
  {id:'interview',name:'Interview'},
  {id:'analyse',name:'Analyse'},
];
function loadImg(src){ return new Promise((res,rej)=>{ const i=new Image(); i.onload=()=>res(i); i.onerror=()=>rej(new Error('img')); i.src=src; }); }

function buildOverlayGrid(){
  const g=document.getElementById('ov-grid'); if(!g) return;
  let html='<button class="ov-tile" data-ov="__none__" title="Kein Overlay">Ohne</button>';
  for(const o of OVERLAY_LIST){
    const src=OVERLAY_DATA[o.id]||'';
    html+=`<button class="ov-tile" data-ov="${o.id}" title="${o.name}"><img src="${src}" alt="${o.name}"><span>${o.name}</span></button>`;
  }
  g.innerHTML=html;
  g.querySelectorAll('.ov-tile').forEach(b=>b.addEventListener('click',()=>selectOverlay(b.dataset.ov)));
  highlightOverlay();
}
function highlightOverlay(){
  document.querySelectorAll('#ov-grid .ov-tile').forEach(t=>t.classList.toggle('active', t.dataset.ov===(overlayId||'__none__')));
}
async function selectOverlay(id){
  overlayId = id==='__none__' ? null : id;
  highlightOverlay();
  if(overlayId){ try{ overlayImg=await loadImg(OVERLAY_DATA[overlayId]); }catch(e){ overlayImg=null; } }
  else { overlayImg=null; }
  resetOverlayMask();
  updateBrushUi();
  if(originalImage) applyEffect();
}
function resetOverlayMask(){
  if(!originalImage){ overlayMask=null; return; }
  const W=canvas.width,H=canvas.height;
  overlayMask=document.createElement('canvas'); overlayMask.width=W; overlayMask.height=H;
  const m=overlayMask.getContext('2d'); m.fillStyle='#fff'; m.fillRect(0,0,W,H);
}
function ensureOverlayMaskSize(){
  if(!originalImage) return;
  if(!overlayMask || overlayMask.width!==canvas.width || overlayMask.height!==canvas.height) resetOverlayMask();
}
let _ovTmp=null;
function drawOverlayLayer(){
  if(!overlayImg || !overlayMask) return;
  const W=canvas.width,H=canvas.height;
  if(!_ovTmp || _ovTmp.width!==W || _ovTmp.height!==H){ _ovTmp=document.createElement('canvas'); _ovTmp.width=W; _ovTmp.height=H; }
  const t=_ovTmp.getContext('2d');
  t.globalCompositeOperation='source-over'; t.clearRect(0,0,W,H);
  t.drawImage(overlayImg,0,0,W,H);
  t.globalCompositeOperation='destination-in'; t.drawImage(overlayMask,0,0);
  t.globalCompositeOperation='source-over';
  ctx.drawImage(_ovTmp,0,0);
}
function cacheEffectResult(){
  const W=canvas.width,H=canvas.height;
  if(!effectCache || effectCache.width!==W || effectCache.height!==H){ effectCache=document.createElement('canvas'); effectCache.width=W; effectCache.height=H; }
  const c=effectCache.getContext('2d'); c.globalCompositeOperation='source-over'; c.clearRect(0,0,W,H); c.drawImage(canvas,0,0);
}
function recompositeOverlay(){
  if(!effectCache){ if(originalImage) applyEffect(); return; }
  const W=canvas.width,H=canvas.height;
  ctx.clearRect(0,0,W,H); ctx.drawImage(effectCache,0,0);
  if (decoMode==='overlay') drawOverlayLayer();
  if (decoMode==='border') {
    const bw=parseInt(document.getElementById('border-width').value);
    addBorder(bw, document.getElementById('border-color').value);
  }
}

// Pop-Out-Pinsel (bearbeitet die Overlay-Maske)
function brushCoords(e){
  const r=canvas.getBoundingClientRect();
  return { x:(e.clientX-r.left)*(canvas.width/r.width), y:(e.clientY-r.top)*(canvas.height/r.height) };
}
function paintOverlayMask(cx,cy){
  if(!overlayMask) return;
  const m=overlayMask.getContext('2d');
  const r=ovBrushSize;
  const innerStop=Math.min(0.95, ovBrushHardness/100);
  const erase=brushMode==='erase';
  const grad=m.createRadialGradient(cx,cy,0,cx,cy,r);
  grad.addColorStop(0, erase?'rgba(0,0,0,1)':'rgba(255,255,255,1)');
  grad.addColorStop(innerStop, erase?'rgba(0,0,0,0.6)':'rgba(255,255,255,0.6)');
  grad.addColorStop(1, erase?'rgba(0,0,0,0)':'rgba(255,255,255,0)');
  m.globalCompositeOperation = erase ? 'destination-out' : 'source-over';
  m.fillStyle=grad; m.beginPath(); m.arc(cx,cy,r,0,Math.PI*2); m.fill();
  m.globalCompositeOperation='source-over';
}
// Kreisvorschau des Pop-Out-Pinsels (folgt dem Zeiger, zeigt die echte Größe)
function positionBrushPreview(e){
  const el=document.getElementById('brushPreview'); if(!el) return;
  const r=canvas.getBoundingClientRect(); if(r.width<=0) return;
  const scale=r.width/canvas.width;
  const d=ovBrushSize*2*scale;
  el.style.width=d+'px'; el.style.height=d+'px';
  el.style.left=(e.clientX-r.left)+'px';
  el.style.top=(e.clientY-r.top)+'px';
}
function updateBrushPreviewSize(){
  const el=document.getElementById('brushPreview'); if(!el || el.style.display==='none') return;
  const r=canvas.getBoundingClientRect(); if(r.width<=0) return;
  const d=ovBrushSize*2*(r.width/canvas.width);
  el.style.width=d+'px'; el.style.height=d+'px';
}
function showBrushPreview(e){
  if(!brushActive || !overlayImg) return;
  const el=document.getElementById('brushPreview'); if(!el) return;
  positionBrushPreview(e); el.style.display='block';
}
function hideBrushPreview(){ const el=document.getElementById('brushPreview'); if(el) el.style.display='none'; }

function bindOverlayBrush(){
  let painting=false, scheduled=false;
  const stroke=(x,y)=>{ paintOverlayMask(x,y); if(!scheduled){ scheduled=true; requestAnimationFrame(()=>{ scheduled=false; recompositeOverlay(); }); } };
  canvas.addEventListener('pointerdown', e=>{
    if(!brushActive || !overlayImg) return;
    e.preventDefault(); try{ canvas.setPointerCapture(e.pointerId); }catch(_){} painting=true;
    const {x,y}=brushCoords(e); stroke(x,y);
  });
  canvas.addEventListener('pointermove', e=>{
    if(brushActive && overlayImg) showBrushPreview(e); // Vorschau folgt dem Zeiger
    if(!painting) return;
    const {x,y}=brushCoords(e); stroke(x,y);
  });
  canvas.addEventListener('pointerenter', e=>{ if(brushActive && overlayImg) showBrushPreview(e); });
  canvas.addEventListener('pointerleave', hideBrushPreview);
  canvas.addEventListener('pointerup', ()=>{ painting=false; });
  canvas.addEventListener('pointercancel', ()=>{ painting=false; });
}
function overlayBrushCursor(){
  if(!brushActive || !overlayImg){ canvas.style.cursor=''; hideBrushPreview(); return; }
  canvas.style.cursor='crosshair'; // Größe zeigt der Vorschaukreis
}
function updateBrushUi(){
  const canBrush=!!overlayImg;
  const grp=document.getElementById('ov-brush-controls');
  if(grp) grp.classList.toggle('disabled', !canBrush);
  if(!canBrush) brushActive=false;
  const tgl=document.getElementById('ov-brush-toggle');
  if(tgl){ tgl.disabled=!canBrush; tgl.classList.toggle('active', brushActive); tgl.textContent=brushActive?'Pinsel aktiv ✓':'Pop-Out-Pinsel'; }
  overlayBrushCursor();
}

// Unschärfe-Hintergrund (Blur-Fill) für Hochkant / Nicht-16:9
function drawImageCoverZoom(c,img,W,H,zoom){
  const cR=W/H, mR=img.width/img.height; let dw,dh;
  if(mR>cR){ dh=H*zoom; dw=dh*mR; } else { dw=W*zoom; dh=dw/mR; }
  c.drawImage(img,(W-dw)/2,(H-dh)/2,dw,dh);
}
function drawImageContain2(c,img,W,H){
  const cR=W/H, mR=img.width/img.height; let dw,dh;
  if(mR>cR){ dw=W; dh=dw/mR; } else { dh=H; dw=dh*mR; }
  c.drawImage(img,(W-dw)/2,(H-dh)/2,dw,dh);
}
function buildBlurFillCanvas(img, blur, bg){
  const AR=16/9, mR=img.width/img.height; let W,H;
  if(mR<AR){ H=img.height; W=Math.round(H*AR); } else { W=img.width; H=Math.round(W/AR); }
  const c=document.createElement('canvas'); c.width=W; c.height=H;
  const x=c.getContext('2d'); x.imageSmoothingQuality='high';
  // Deckende Hintergrundfarbe zuerst — so bleiben die Ränder auch bei starker
  // Unschärfe (weiche, teiltransparente Blur-Kante) blickdicht bis zum Rand.
  if(bg){ x.fillStyle=bg; x.fillRect(0,0,W,H); }
  const b=Math.max(0,Math.min(100, blur|0));
  if(b>0) x.filter=`blur(${b}px)`;
  drawImageCoverZoom(x,img,W,H,1.12);
  x.filter='none';
  drawImageContain2(x,img,W,H);
  return c;
}
let _fillToken=0;
async function applyBlurFill(){
  if(!sourceImage) return;
  fillActive=true; const my=++_fillToken;
  const bg=document.getElementById('fill-bg')?.value || '#101418';
  const url=buildBlurFillCanvas(sourceImage, fillBlur, bg).toDataURL('image/png');
  let im; try{ im=await loadImg(url); }catch(e){ return; }
  if(my!==_fillToken) return;
  originalImage=im; overlayMask=null; effectCache=null;
  updateFillUi(); applyEffect();
}
function revertFill(){
  if(!sourceImage) return;
  fillActive=false; originalImage=sourceImage; overlayMask=null; effectCache=null;
  updateFillUi(); if(originalImage) applyEffect();
}
function updateFillUi(){
  const btn=document.getElementById('fill-apply'); if(btn) btn.classList.toggle('active', fillActive);
  const rev=document.getElementById('fill-revert'); if(rev) rev.disabled=!fillActive;
}

// Init Overlay / Brush / Fill
buildOverlayGrid();
bindOverlayBrush();
(function initOverlayFillUi(){
  document.getElementById('ov-brush-toggle')?.addEventListener('click', ()=>{ if(!overlayImg) return; brushActive=!brushActive; updateBrushUi(); });
  document.querySelectorAll('#ov-brush-mode .seg-btn').forEach(b=>b.addEventListener('click', ()=>{
    document.querySelectorAll('#ov-brush-mode .seg-btn').forEach(x=>x.classList.remove('active'));
    b.classList.add('active'); brushMode=b.dataset.bmode;
  }));
  const bs=document.getElementById('ov-brush-size');
  bs?.addEventListener('input', ()=>{ ovBrushSize=+bs.value; const d=document.getElementById('ov-brush-size-disp'); if(d) d.innerHTML=ovBrushSize+'&nbsp;px'; overlayBrushCursor(); updateBrushPreviewSize(); });
  const bh=document.getElementById('ov-brush-hard');
  bh?.addEventListener('input', ()=>{ ovBrushHardness=+bh.value; const d=document.getElementById('ov-brush-hard-disp'); if(d) d.textContent=ovBrushHardness; });
  document.getElementById('ov-brush-reset')?.addEventListener('click', ()=>{ resetOverlayMask(); recompositeOverlay(); });
  const fb=document.getElementById('fill-blur');
  fb?.addEventListener('input', ()=>{ fillBlur=+fb.value; const d=document.getElementById('fill-blur-disp'); if(d) d.innerHTML=fillBlur+'&nbsp;px'; if(fillActive) applyBlurFill(); });
  document.getElementById('fill-bg')?.addEventListener('change', ()=>{ if(fillActive) applyBlurFill(); });
  document.getElementById('fill-apply')?.addEventListener('click', ()=>{ if(originalImage) applyBlurFill(); });
  document.getElementById('fill-revert')?.addEventListener('click', revertFill);
  window.addEventListener('resize', overlayBrushCursor);
  updateBrushUi();
})();

