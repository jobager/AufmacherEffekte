// ── Crop 16:9 ───────────────────────────────────────────────────
const ASPECT = 16 / 9;
// State machine: 'off' | 'drawing' | 'drawn'
let cropState  = 'off';
let cropAnchor = null;
let cropCorner = null;
const cropOv     = document.getElementById('cropOverlay');
const cropRectEl = document.getElementById('cropRect');

function enterCrop() {
  if (!originalImage) return;
  cropState = 'drawing'; cropAnchor = cropCorner = null;
  cropRectEl.style.display = 'none';
  clearShades();
  cropOv.style.display = 'block';
  document.getElementById('crop-controls-normal').style.display = 'none';
  document.getElementById('crop-controls-active').style.display = 'flex';
}
function exitCrop() {
  cropState = 'off'; cropAnchor = cropCorner = null;
  cropOv.style.display = 'none';
  cropRectEl.style.display = 'none';
  document.getElementById('crop-controls-normal').style.display = 'block';
  document.getElementById('crop-controls-active').style.display = 'none';
}
function clearShades() { updateCropShades(0,0,0,0); }

document.getElementById('cropBtn').addEventListener('click', enterCrop);
document.getElementById('cropCancel').addEventListener('click', exitCrop);
document.getElementById('cropConfirm').addEventListener('click', () => {
  if (!cropAnchor || !cropCorner) { exitCrop(); return; }
  const {rx,ry,rw,rh} = getCropRect();
  if (rw < 4 || rh < 4) { exitCrop(); return; }
  const canvasRect = canvas.getBoundingClientRect();
  const areaRect   = cropOv.getBoundingClientRect();
  const offX = canvasRect.left - areaRect.left;
  const offY = canvasRect.top  - areaRect.top;
  const scX  = canvas.width  / canvasRect.width;
  const scY  = canvas.height / canvasRect.height;
  const cx = Math.max(0, Math.round((rx - offX) * scX));
  const cy = Math.max(0, Math.round((ry - offY) * scY));
  const cw = Math.min(Math.round(rw * scX), canvas.width  - cx);
  const ch = Math.min(Math.round(rh * scY), canvas.height - cy);
  if (cw < 2 || ch < 2) { exitCrop(); return; }
  const tmp = document.createElement('canvas'); tmp.width=cw; tmp.height=ch;
  tmp.getContext('2d').drawImage(canvas, cx, cy, cw, ch, 0, 0, cw, ch);
  const img = new Image();
  img.onload = () => {
    originalImage=img; sourceImage=img; fillActive=false;
    overlayId=null; overlayImg=null; overlayMask=null; effectCache=null; brushActive=false;
    setDecoMode('none');
    highlightOverlay(); updateFillUi(); updateBrushUi();
    exitCrop(); applyEffect();
  };
  img.src = tmp.toDataURL();
});

cropOv.addEventListener('pointerdown', e => {
  if (cropState === 'off') return;
  e.preventDefault();
  cropState  = 'drawing';
  cropAnchor = getOvPos(e);
  cropCorner = { x: cropAnchor.x, y: cropAnchor.y };
  cropRectEl.style.display = 'none';
  clearShades();
  cropOv.setPointerCapture(e.pointerId);
});
cropOv.addEventListener('pointermove', e => {
  if (cropState !== 'drawing' || !cropAnchor) return;
  cropCorner = getOvPos(e);
  const {rx,ry,rw,rh} = getCropRect();
  if (rw > 2) {
    cropRectEl.style.cssText =
      `position:absolute;display:block;border:2px solid #fff;` +
      `box-shadow:0 0 0 1px rgba(0,0,0,.6);pointer-events:none;` +
      `left:${rx}px;top:${ry}px;width:${rw}px;height:${rh}px`;
    updateCropShades(rx,ry,rw,rh);
  }
});
cropOv.addEventListener('pointerup', e => {
  if (cropState !== 'drawing') return;
  cropCorner = getOvPos(e);
  const {rw,rh} = getCropRect();
  if (rw > 10 && rh > 10) {
    cropState = 'drawn';
  } else {
    cropRectEl.style.display = 'none';
    clearShades();
    cropAnchor = cropCorner = null;
  }
});

function getOvPos(e) {
  const r = cropOv.getBoundingClientRect();
  return { x: Math.max(0, Math.min(r.width,  e.clientX - r.left)),
           y: Math.max(0, Math.min(r.height, e.clientY - r.top)) };
}
function getCropRect() {
  if (!cropAnchor || !cropCorner) return {rx:0,ry:0,rw:0,rh:0};
  let rx = Math.min(cropAnchor.x, cropCorner.x);
  let ry = Math.min(cropAnchor.y, cropCorner.y);
  let rw = Math.abs(cropCorner.x - cropAnchor.x);
  let rh = Math.abs(cropCorner.y - cropAnchor.y);
  if (rw / Math.max(rh,0.01) > ASPECT) rh = rw / ASPECT; else rw = rh * ASPECT;
  const maxW = cropOv.offsetWidth - rx, maxH = cropOv.offsetHeight - ry;
  if (rw > maxW) { rw = maxW; rh = rw / ASPECT; }
  if (rh > maxH) { rh = maxH; rw = rh * ASPECT; }
  return {rx, ry, rw, rh};
}
function updateCropShades(rx,ry,rw,rh) {
  const W = cropOv.offsetWidth, H = cropOv.offsetHeight;
  const s = (id,l,t,w,h) => {
    document.getElementById(id).style.cssText =
      `position:absolute;background:rgba(0,0,0,.55);pointer-events:none;` +
      `left:${l}px;top:${t}px;width:${w}px;height:${h}px`;
  };
  s('cShadeT', 0,     0,     W,       ry     );
  s('cShadeB', 0,     ry+rh, W,       H-ry-rh);
  s('cShadeL', 0,     ry,    rx,      rh     );
  s('cShadeR', rx+rw, ry,    W-rx-rw, rh     );
}

