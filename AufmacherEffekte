  for (let i=0; i<d.length; i+=4) {
    let lum = 0.299*d[i]+0.587*d[i+1]+0.114*d[i+2];
    // apply pre-contrast
    lum = Math.min(255,Math.max(0,(lum-128)*(1+contrast/50)+128));
    if (mode==='hard') {
      const c = lum < level ? dark : light;
      d[i]=c[0]; d[i+1]=c[1]; d[i+2]=c[2];
    } else if (mode==='smooth') {
      const edge = 8;
