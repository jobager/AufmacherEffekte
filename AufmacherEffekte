// ── Blueprint (Sobel-Kanten + einfarbige Tönung) ───────
function applyBlueprint(imgData){
  const bg=hexToRgb(document.getElementById('bp-bg').value);
  const line=hexToRgb(document.getElementById('bp-line').value);
  const strength=parseInt(document.getElementById('bp-strength').value)/100;
  const W=imgData.width,H=imgData.height;
  const d=imgData.data;
  const lum=new Float32Array(W*H);
  for(let p=0,q=0;p<d.length;p+=4,q++) lum[q]=0.299*d[p]+0.587*d[p+1]+0.114*d[p+2];
  const gain=1+strength*8;
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){
    const i=(y*W+x)*4;
    const xm=x>0?x-1:x, xp=x<W-1?x+1:x, ym=y>0?y-1:y, yp=y<H-1?y+1:y;
    const tl=lum[ym*W+xm],t=lum[ym*W+x],tr=lum[ym*W+xp];
    const ml=lum[y*W+xm],               mr=lum[y*W+xp];
    const bl=lum[yp*W+xm],b=lum[yp*W+x],br=lum[yp*W+xp];
    const gx=(tr+2*mr+br)-(tl+2*ml+bl);
    const gy=(bl+2*b+br)-(tl+2*t+tr);
    const mag=Math.sqrt(gx*gx+gy*gy)/1442;
    const e=Math.min(1,mag*gain);
    d[i]  =bg[0]+(line[0]-bg[0])*e;
    d[i+1]=bg[1]+(line[1]-bg[1])*e;
    d[i+2]=bg[2]+(line[2]-bg[2])*e;
  }
  return imgData;
}

